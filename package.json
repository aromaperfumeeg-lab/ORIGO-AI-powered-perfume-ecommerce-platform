{
  "name": "origo-store",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "terser app.js --compress passes=2,toplevel=true --mangle toplevel --output app.min.js",
    "build:deploy": "pnpm run build && node scripts/build-deploy.mjs",
    "build:knowledge": "node scripts/build-fragrance-knowledge.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs --confirm-reset",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "node --check db.mjs && node --check server.mjs && node --check scripts/reset-admin-password.mjs",
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "nodemailer": "7.0.11",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "terser": "5.39.0"
  }
}
